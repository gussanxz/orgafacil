<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_fundo_home"
    android:paddingBottom="20dp"
    tools:context=".funcionalidades.main.HomeActivity">

    <!-- ════════════════════════════════════════════
         LOGO
         ════════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/imageViewLogoHome"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="28dp"
        android:contentDescription="@string/app_name"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo_orgafacil_96x96" />

    <!-- ════════════════════════════════════════════
         SAUDAÇÃO
         ════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/textViewSaudacao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="24dp"
        android:text="@string/saudacao_home"
        android:textColor="@color/cor_saudacao_home"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageViewLogoHome" />

    <TextView
        android:id="@+id/textViewNomeUsuario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:textColor="@color/cor_nome_usuario_home"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewSaudacao"
        tools:text="Gustavo Santos" />

    <!-- ════════════════════════════════════════════
         LINHA 1 — Contas | Vendas
         top da chain: top→nomeUsuario, bottom→cardMercado
         chain style spread_inside + weight=1 em cada par
         ════════════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardContas"
        style="@style/Widget.HomeCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="6dp"
        android:onClick="acessarResumoContasActivity"
        app:layout_constraintBottom_toTopOf="@id/cardMercado"
        app:layout_constraintEnd_toStartOf="@id/cardVendas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewNomeUsuario"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:layout_constraintVertical_weight="1">

        <include layout="@layout/item_card_home" />

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardVendas"
        style="@style/Widget.HomeCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:onClick="acessarResumoVendasAcitivity"
        app:layout_constraintBottom_toTopOf="@id/cardAtividades"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardContas"
        app:layout_constraintTop_toBottomOf="@id/textViewNomeUsuario"
        app:layout_constraintVertical_weight="1">

        <include layout="@layout/item_card_home" />

    </androidx.cardview.widget.CardView>

    <!-- ════════════════════════════════════════════
         LINHA 2 — Mercado | Atividades
         ════════════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMercado"
        style="@style/Widget.HomeCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="6dp"
        android:onClick="acessarListaMercado"
        app:layout_constraintBottom_toTopOf="@id/cardBoleto"
        app:layout_constraintEnd_toStartOf="@id/cardAtividades"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardContas"
        app:layout_constraintVertical_weight="1">

        <include layout="@layout/item_card_home" />

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardAtividades"
        style="@style/Widget.HomeCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@id/cardMinhaConta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardMercado"
        app:layout_constraintTop_toBottomOf="@id/cardVendas"
        app:layout_constraintVertical_weight="1">

        <include layout="@layout/item_card_home" />

    </androidx.cardview.widget.CardView>

    <!-- ════════════════════════════════════════════
         LINHA 3 — Boleto | Minha Conta
         bottom→parent fecha a chain vertical
         ════════════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBoleto"
        style="@style/Widget.HomeCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardMinhaConta"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardMercado"
        app:layout_constraintVertical_weight="1">

        <include layout="@layout/item_card_home" />

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardMinhaConta"
        style="@style/Widget.HomeCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="16dp"
        android:onClick="acessarConfigs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cardBoleto"
        app:layout_constraintTop_toBottomOf="@id/cardAtividades"
        app:layout_constraintVertical_weight="1">

        <include layout="@layout/item_card_home" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>