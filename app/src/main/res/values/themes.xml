<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.OrgaFacil" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@color/cor_barra_status</item>
        <item name="android:navigationBarColor">@color/cor_botoes_navegacao</item>

        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.OrgaFacil" parent="Base.Theme.OrgaFacil" />

    <style name="despesaTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimaryDespesa</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDarkDespesa</item>
        <item name="colorAccent">@color/colorAccentDespesa</item>
    </style>

    <style name="proventosTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimaryProventos</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDarkProventos</item>
        <item name="colorAccent">@color/colorAccentProventos</item>
    </style>

    <style name="principalTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="backgroundColor">@color/colorPrimary</item>
        <item name="colorPrimary">@color/colorPrimaryProventos</item>
    </style>

    <style name="NoElevationFab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="elevation">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="postSplashScreenTheme">@style/Theme.OrgaFacil</item>
    </style>

    <!--
    ══════════════════════════════════════════════════════════════
    ADICIONE ESTES ESTILOS ao seu themes.xml (ou crie um styles.xml)
    ══════════════════════════════════════════════════════════════

    Widget.HomeCard
    ───────────────
    Estilo base dos cards da grade da home.
    Centraliza todas as propriedades visuais dos cards em um lugar:
    cantos arredondados, cor de fundo, elevação e tamanho mínimo.

    Para ajustar TODOS os cards da home de uma vez (ex: mudar o
    corner radius de 16dp para 20dp), edite apenas aqui.
-->

    <!-- Cole dentro da tag <resources> do seu themes.xml: -->

    <style name="Widget.HomeCard" parent="">

        <!-- Aparência do card -->
        <item name="cardBackgroundColor">@color/cor_card_home</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/cor_card_stroke_home</item>

        <!-- Feedback de toque -->
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>