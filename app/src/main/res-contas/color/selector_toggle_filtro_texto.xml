<?xml version="1.0" encoding="utf-8"?>
<!--
    selector_toggle_filtro_texto.xml  (color selector)
    Cor do texto dos RadioButtons do filtro de contas.
    Selecionado  → texto escuro (#1A1A1A) sobre fundo branco
    Normal       → texto branco (#FFFFFF) sobre fundo transparente/teal
    Vai em: res-contas/color/selector_toggle_filtro_texto.xml
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true"  android:color="#1A1A1A" />
    <item android:state_checked="false" android:color="#FFFFFF" />
</selector>