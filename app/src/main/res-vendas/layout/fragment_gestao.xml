<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Linha 1: Vendas | Estoque -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Card Vendas (Histórico) -->
            <LinearLayout
                android:id="@+id/cardVendas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_vendas_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icone_card"
                    android:backgroundTint="#E6F5EE"
                    android:gravity="center"
                    android:clipToOutline="true">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_monitoring_28"
                        app:tint="#1D9E75"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vendas"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/cor_titulo_card_vendas"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Histórico detalhado"
                    android:textSize="12sp"
                    android:textColor="@color/cor_subtitulo_card_vendas"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

            <!-- Card Estoque (bloqueado) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_vendas_card"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/cardEstoque"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icone_card"
                        android:backgroundTint="#F0F0F0"
                        android:gravity="center"
                        android:clipToOutline="true">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_inventory_28"
                            app:tint="#AAAAAA"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estoque"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/cor_subtitulo_card_vendas"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Em breve no seu plano"
                        android:textSize="12sp"
                        android:textColor="@color/cor_subtitulo_card_vendas"
                        android:layout_marginTop="3dp"/>

                </LinearLayout>

                <ImageView
                    android:id="@+id/overlayEstoque"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#55000000"
                    android:src="@drawable/ic_lock_24"
                    android:scaleType="center"
                    app:tint="@android:color/white"
                    android:visibility="visible"
                    android:elevation="10dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </FrameLayout>

        </LinearLayout>

        <!-- Linha 2: Devoluções | Relatórios -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="10dp">

            <!-- Card Devoluções (bloqueado) -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_vendas_card"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/cardDevolucoes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icone_card"
                        android:backgroundTint="#F0F0F0"
                        android:gravity="center"
                        android:clipToOutline="true">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_assignment_return_28"
                            app:tint="#AAAAAA"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Devoluções"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/cor_subtitulo_card_vendas"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Em breve no seu plano"
                        android:textSize="12sp"
                        android:textColor="@color/cor_subtitulo_card_vendas"
                        android:layout_marginTop="3dp"/>

                </LinearLayout>

                <ImageView
                    android:id="@+id/overlayDevolucoes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#55000000"
                    android:src="@drawable/ic_lock_24"
                    android:scaleType="center"
                    app:tint="@android:color/white"
                    android:visibility="visible"
                    android:elevation="10dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </FrameLayout>

            <!-- Card Relatórios -->
            <LinearLayout
                android:id="@+id/cardRelatorios"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_vendas_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icone_card"
                    android:backgroundTint="#E8EEF8"
                    android:gravity="center"
                    android:clipToOutline="true">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_analytics_28"
                        app:tint="#4A7BCC"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Relatórios"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/cor_titulo_card_vendas"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resumo do mês"
                    android:textSize="12sp"
                    android:textColor="@color/cor_subtitulo_card_vendas"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Linha 3: Controle de caixa | Financeiro -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginTop="10dp">

            <!-- Card Controle de Caixa -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_vendas_card"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/cardControleCaixa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icone_card"
                        android:backgroundTint="#FFF3E0"
                        android:gravity="center"
                        android:clipToOutline="true">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_point_of_sale_28"
                            app:tint="#E08D00"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Controle de caixa"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="@color/cor_titulo_card_vendas"
                        android:layout_marginTop="10dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Abertura e fechamento"
                        android:textSize="12sp"
                        android:textColor="@color/cor_subtitulo_card_vendas"
                        android:layout_marginTop="3dp"/>

                </LinearLayout>

                <ImageView
                    android:id="@+id/overlayControleCaixa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#55000000"
                    android:src="@drawable/ic_lock_24"
                    android:scaleType="center"
                    app:tint="@android:color/white"
                    android:visibility="visible"
                    android:elevation="10dp"
                    android:clickable="true"
                    android:focusable="true"/>
            </FrameLayout>

            <!-- Card Financeiro -->
            <LinearLayout
                android:id="@+id/cardFinanceiro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_vendas_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icone_card"
                    android:backgroundTint="#E6F5EE"
                    android:gravity="center"
                    android:clipToOutline="true">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_paid_28"
                        app:tint="#1D9E75"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Financeiro"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/cor_titulo_card_vendas"
                    android:layout_marginTop="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entradas e saídas"
                    android:textSize="12sp"
                    android:textColor="@color/cor_subtitulo_card_vendas"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
