<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/dialog_warning_surface"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <View
                android:id="@+id/viewFundoIcone"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_btn_excluir_circular"
                android:backgroundTint="@color/dialog_warning_icon_bg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imgIconeDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_warning_24"
                app:layout_constraintBottom_toBottomOf="@id/viewFundoIcone"
                app:layout_constraintEnd_toEndOf="@id/viewFundoIcone"
                app:layout_constraintStart_toStartOf="@id/viewFundoIcone"
                app:layout_constraintTop_toTopOf="@id/viewFundoIcone"
                app:tint="@color/dialog_warning_accent" />

            <TextView
                android:id="@+id/textTituloDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Não foi possível excluir"
                android:textColor="@color/dialog_warning_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/viewFundoIcone" />

            <TextView
                android:id="@+id/textMensagemDialog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/dialog_warning_text_secondary"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textTituloDialog" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEntendiDialog"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/dialog_warning_accent"
                android:text="Entendi"
                android:textColor="@color/dialog_warning_button_text"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textMensagemDialog" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
