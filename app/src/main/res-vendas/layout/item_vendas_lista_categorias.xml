<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:id="@+id/cardRoot"
    app:cardCornerRadius="12dp"
    app:cardBackgroundColor="@color/vendas_card"
    app:cardElevation="1dp"
    app:strokeColor="@color/vendas_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/layoutCategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Ícone / Avatar da categoria -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardIconeCategoria"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="#E6F5EE"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/imgIconeCategoria"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:padding="10dp"
                android:src="@drawable/ic_label_24"
                app:tint="#1D9E75" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Nome + descrição -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textNomeCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome da Categoria"
                android:textColor="@color/cor_texto_primario"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textDescCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Descrição curta..."
                android:textColor="@color/vendas_text_secondary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Status dot + "Ativa" label -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginEnd="6dp">

            <View
                android:id="@+id/textStatus"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_status_ativo"
                android:layout_marginEnd="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ativa"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Chevron -->
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right_24"
            app:tint="@color/cor_icone_secundario" />

        <!-- Delete button (kept for adapter compat, hidden) -->
        <ImageButton
            android:id="@+id/btnExcluirCategoria"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_lixeira_excluir_24"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Excluir"
            app:tint="#F44336"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
