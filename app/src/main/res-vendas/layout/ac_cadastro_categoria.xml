<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cadastro_categoria_header"
    tools:context=".funcionalidades.vendas.visual.cadastros.catalogo.categoria.CadastroCategoriaCatalogoActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="84dp"
        android:background="@color/cadastro_categoria_header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabVoltar"
            style="@style/NoElevationFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:onClick="retornarParaVendasCadastros"
            app:backgroundTint="@color/cadastro_categoria_header_action"
            app:fabCustomSize="44dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_arrow_back_24"
            app:tint="@color/cadastro_categoria_on_accent" />

        <LinearLayout
            android:id="@+id/headerTextContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/fabVoltar"
            app:layout_constraintEnd_toStartOf="@id/btnExcluirHeader"
            app:layout_constraintStart_toEndOf="@id/fabVoltar"
            app:layout_constraintTop_toTopOf="@id/fabVoltar">

            <TextView
                android:id="@+id/textViewHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Nova Categoria"
                android:textColor="@color/cadastro_categoria_on_accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Preencha para cadastrar"
                android:textColor="#D6FFFB"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnExcluirHeader"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_cadastro_categoria_header_action"
            android:contentDescription="Excluir Categoria"
            android:padding="10dp"
            android:src="@drawable/ic_lixeira_excluir_24"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/fabSuperiorSalvarCategoria"
            app:layout_constraintEnd_toStartOf="@id/fabSuperiorSalvarCategoria"
            app:layout_constraintTop_toTopOf="@id/fabSuperiorSalvarCategoria"
            app:tint="#FFE5E5" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabSuperiorSalvarCategoria"
            style="@style/NoElevationFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:onClick="salvarCategoria"
            app:backgroundTint="@color/cadastro_categoria_header_action"
            app:fabCustomSize="44dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_confirmar_branco_24"
            app:tint="@color/cadastro_categoria_on_accent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/cadastro_categoria_surface"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="118dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOME DA CATEGORIA"
                android:textColor="@color/cadastro_categoria_label"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:hint=""
                app:boxBackgroundColor="@color/cadastro_categoria_card"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeColor="@color/cadastro_categoria_accent"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:inputType="textCapSentences"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:textColor="@color/cadastro_categoria_text_primary"
                    android:textSize="16sp"
                    android:hint="Insira o nome da categoria" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="DESCRIÃ‡ÃƒO"
                android:textColor="@color/cadastro_categoria_label"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:hint=""
                app:boxBackgroundColor="@color/cadastro_categoria_card"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/cadastro_categoria_stroke"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:gravity="top"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="3"
                    android:paddingStart="18dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="18dp"
                    android:textColor="@color/cadastro_categoria_text_primary"
                    android:textSize="15sp"
                    android:hint="Descreva os produtos/serviÃ§os desta categoria"
                    android:textColorHint="@color/cadastro_categoria_hint" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="STATUS"
                android:textColor="@color/cadastro_categoria_label"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatusCategoria"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:layout_marginTop="7dp"
                app:cardBackgroundColor="@color/cadastro_categoria_card"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/cadastro_categoria_stroke"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="18dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:id="@+id/txtStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Categoria ativa"
                        android:textColor="@color/cadastro_categoria_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toTopOf="@id/txtStatusSubtitle"
                        app:layout_constraintEnd_toStartOf="@id/switchAtiva"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed" />

                    <TextView
                        android:id="@+id/txtStatusSubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="VisÃ­vel no PDV"
                        android:textColor="@color/cadastro_categoria_text_secondary"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/txtStatus"
                        app:layout_constraintStart_toStartOf="@id/txtStatus"
                        app:layout_constraintTop_toBottomOf="@id/txtStatus" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAtiva"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:showText="false"
                        android:text=""
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:thumbTint="@color/cadastro_categoria_on_accent"
                        app:trackTint="@color/selector_cadastro_categoria_switch_track" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/caixa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtLabelVisual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VISUAL"
                    android:textColor="@color/cadastro_categoria_label"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerBotoesVisual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBtnSelecionarIcones"
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_marginEnd="7dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:onClick="exibeSelecaoDeIcones"
                        app:cardBackgroundColor="@color/cadastro_categoria_card_selected"
                        app:cardCornerRadius="13dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/cadastro_categoria_accent"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <ImageButton
                                    android:id="@+id/imgBtnSelecionarIcones"
                                    android:layout_width="30dp"
                                    android:layout_height="30dp"
                                    android:background="@android:color/transparent"
                                    android:contentDescription="Selecionar ícone"
                                    android:onClick="exibeSelecaoDeIcones"
                                    android:padding="3dp"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/ic_categorias_geral_24"
                                    app:tint="@color/cadastro_categoria_accent" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Ícone"
                                android:textColor="@color/cadastro_categoria_accent"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBtnGaleria"
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_marginStart="7dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="@color/cadastro_categoria_card"
                        app:cardCornerRadius="13dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/cadastro_categoria_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:id="@+id/imgBtnGaleria"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:contentDescription="Selecionar da Galeria"
                                android:padding="3dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_photo_library_24"
                                app:tint="@color/cadastro_categoria_label" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Foto"
                                android:textColor="@color/cadastro_categoria_label"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutSelecao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtTituloSelecao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="Selecione:"
                        android:textColor="@color/cadastro_categoria_label"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardPreviewFoto"
                        android:layout_width="match_parent"
                        android:layout_height="230dp"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/cadastro_categoria_card"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/cadastro_categoria_stroke"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/imgPreviewLarge"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_camera_alt_120" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardContainerGrid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/cadastro_categoria_card"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/cadastro_categoria_stroke"
                        app:strokeWidth="1dp">

                        <GridLayout
                            android:id="@+id/containerIcones"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:alignmentMode="alignMargins"
                            android:columnCount="4"
                            android:padding="12dp"
                            android:rowCount="3"
                            android:useDefaultMargins="true">

                            <com.google.android.material.card.MaterialCardView
                                style="@style/WidgetCadastroCategoriaIconOption">
                                <ImageView
                                    style="@style/WidgetCadastroCategoriaIconOptionImage"
                                    android:src="@drawable/ic_categorias_mercado_24" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/WidgetCadastroCategoriaIconOption">
                                <ImageView
                                    style="@style/WidgetCadastroCategoriaIconOptionImage"
                                    android:src="@drawable/ic_categorias_roupas_24" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/WidgetCadastroCategoriaIconOption">
                                <ImageView
                                    style="@style/WidgetCadastroCategoriaIconOptionImage"
                                    android:src="@drawable/ic_categorias_comida_24" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/WidgetCadastroCategoriaIconOption">
                                <ImageView
                                    style="@style/WidgetCadastroCategoriaIconOptionImage"
                                    android:src="@drawable/ic_categorias_bebidas_24" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/WidgetCadastroCategoriaIconOption">
                                <ImageView
                                    style="@style/WidgetCadastroCategoriaIconOptionImage"
                                    android:src="@drawable/ic_categorias_eletronicos_24" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/WidgetCadastroCategoriaIconOption">
                                <ImageView
                                    style="@style/WidgetCadastroCategoriaIconOptionImage"
                                    android:src="@drawable/ic_categorias_spa_24" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/WidgetCadastroCategoriaIconOption">
                                <ImageView
                                    style="@style/WidgetCadastroCategoriaIconOptionImage"
                                    android:src="@drawable/ic_categorias_fitness_24" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/WidgetCadastroCategoriaIconOption">
                                <ImageView
                                    style="@style/WidgetCadastroCategoriaIconOptionImage"
                                    android:src="@drawable/ic_categorias_geral_24" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/WidgetCadastroCategoriaIconOption">
                                <ImageView
                                    style="@style/WidgetCadastroCategoriaIconOptionImage"
                                    android:src="@drawable/ic_categorias_ferramentas_24" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/WidgetCadastroCategoriaIconOption">
                                <ImageView
                                    style="@style/WidgetCadastroCategoriaIconOptionImage"
                                    android:src="@drawable/ic_categorias_papelaria_24" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/WidgetCadastroCategoriaIconOption">
                                <ImageView
                                    style="@style/WidgetCadastroCategoriaIconOptionImage"
                                    android:src="@drawable/ic_categorias_casa_24" />
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                style="@style/WidgetCadastroCategoriaIconOption">
                                <ImageView
                                    style="@style/WidgetCadastroCategoriaIconOptionImage"
                                    android:src="@drawable/ic_categorias_brinquedos_24" />
                            </com.google.android.material.card.MaterialCardView>
                        </GridLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/txtLabelCorIcone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="COR DO ÍCONE"
                        android:textColor="@color/cadastro_categoria_label"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:overScrollMode="never"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/containerCoresIcone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="0dp"
        android:layout_height="94dp"
        android:background="@drawable/bg_cadastro_categoria_bottom_bar"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fabInferiorSalvarCategoria"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:clickable="true"
            android:onClick="salvarCategoria"
            android:text="Salvar categoria"
            android:textAllCaps="false"
            android:textColor="@color/cadastro_categoria_on_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/cadastro_categoria_button"
            app:cornerRadius="16dp"
            app:elevation="0dp"
            app:icon="@drawable/ic_confirmar_branco_24"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconTint="@color/cadastro_categoria_on_accent" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/cadastro_categoria_on_accent" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
