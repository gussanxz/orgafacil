<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCadastros"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:orientation="vertical"
    tools:context=".activity.features.vendas.operacoesdiarias.cadastros.VendasCadastrosActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnVoltarCadastros"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Voltar"
            android:src="@drawable/ic_arrow_back_48"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTituloCadastros"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cadastros"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Organize produtos, clientes e equipe"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/header_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- ESTRUTURA DE PRODUTOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:text="ESTRUTURA DE PRODUTOS"
                android:textColor="@color/cor_texto_secundario"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Categorias -->
            <LinearLayout
                android:id="@+id/itemCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/fundo_arredondado"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:onClick="exibirCadastroCategorias"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_card"
                    android:backgroundTint="#E6F5EE"
                    android:gravity="center"
                    android:clipToOutline="true"
                    android:layout_marginEnd="12dp">
                    <ImageView
                        android:id="@+id/iconCategorias"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_category_24"
                        app:tint="#1D9E75" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Categorias"
                        android:textColor="@color/cor_texto_primario"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Organize para facilitar a busca no PDV"
                        android:textColor="@color/cor_texto_secundario"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/cor_icone_secundario" />
            </LinearLayout>

            <!-- Produtos e serviços -->
            <LinearLayout
                android:id="@+id/itemProdutosServicos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/fundo_arredondado"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:onClick="exibirListaProdutosServicos"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_card"
                    android:backgroundTint="#FFF3E0"
                    android:gravity="center"
                    android:clipToOutline="true"
                    android:layout_marginEnd="12dp">
                    <ImageView
                        android:id="@+id/iconProdutosServicos"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_inventory_2_28"
                        app:tint="#E08D00" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Produtos e serviços"
                        android:textColor="@color/cor_texto_primario"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Itens, estoque, preço e código"
                        android:textColor="@color/cor_texto_secundario"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right_24"
                    app:tint="@color/cor_icone_secundario" />
            </LinearLayout>

            <!-- Combos (lock indicator in row) -->
            <LinearLayout
                android:id="@+id/itemCombos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/fundo_arredondado"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:onClick="exibirCadastroCombos"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_card"
                    android:backgroundTint="#E8EEF8"
                    android:gravity="center"
                    android:clipToOutline="true"
                    android:layout_marginEnd="12dp">
                    <ImageView
                        android:id="@+id/iconCombos"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_layers_24"
                        app:tint="#4A7BCC" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Combos"
                        android:textColor="@color/cor_texto_primario"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Kits de produtos a preço especial"
                        android:textColor="@color/cor_texto_secundario"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/overlayCombos"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_lock_24"
                    app:tint="#BBBBBB" />
            </LinearLayout>

            <!-- Modificadores (lock indicator in row) -->
            <LinearLayout
                android:id="@+id/itemModificadores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:background="@drawable/fundo_arredondado"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:onClick="exibirCadastroModificadores"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_card"
                    android:backgroundTint="#E6F5EE"
                    android:gravity="center"
                    android:clipToOutline="true"
                    android:layout_marginEnd="12dp">
                    <ImageView
                        android:id="@+id/iconModificadores"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_tune_24"
                        app:tint="#1D9E75" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Modificadores"
                        android:textColor="@color/cor_texto_primario"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Quantidade, adicional, desconto, tama..."
                        android:textColor="@color/cor_texto_secundario"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/overlayModificadores"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_lock_24"
                    app:tint="#BBBBBB" />
            </LinearLayout>

            <!-- PESSOAS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="PESSOAS"
                android:textColor="@color/cor_texto_secundario"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <!-- Clientes -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/fundo_arredondado"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/itemClientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icone_card"
                        android:backgroundTint="#E6F5EE"
                        android:gravity="center"
                        android:clipToOutline="true"
                        android:layout_marginEnd="12dp">
                        <ImageView
                            android:id="@+id/iconClientes"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_person_24"
                            app:tint="#1D9E75" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Clientes"
                            android:textColor="@color/cor_texto_primario"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Histórico e vendas no fiado"
                            android:textColor="@color/cor_texto_secundario"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_chevron_right_24"
                        app:tint="@color/cor_icone_secundario" />
                </LinearLayout>

                <View
                    android:id="@+id/overlayClientes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Fornecedores (PRO) -->
            <LinearLayout
                android:id="@+id/itemFornecedores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/fundo_arredondado"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_card"
                    android:backgroundTint="#F0F0F0"
                    android:gravity="center"
                    android:clipToOutline="true"
                    android:layout_marginEnd="12dp">
                    <ImageView
                        android:id="@+id/iconFornecedores"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_local_shipping_24"
                        app:tint="#BBBBBB" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fornecedores"
                        android:textColor="@color/cor_texto_secundario"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Disponível no plano PRO"
                        android:textColor="@color/cor_texto_secundario"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/overlayFornecedores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pro_badge"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="PRO"
                    android:textColor="#E08D00"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Vendedores (PRO) -->
            <LinearLayout
                android:id="@+id/itemVendedores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/fundo_arredondado"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icone_card"
                    android:backgroundTint="#F0F0F0"
                    android:gravity="center"
                    android:clipToOutline="true"
                    android:layout_marginEnd="12dp">
                    <ImageView
                        android:id="@+id/iconVendedores"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_badge_24"
                        app:tint="#BBBBBB" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Vendedores"
                        android:textColor="@color/cor_texto_secundario"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Disponível no plano PRO"
                        android:textColor="@color/cor_texto_secundario"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/overlayVendedores"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pro_badge"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="PRO"
                    android:textColor="#E08D00"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="20dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
