<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_background"
    tools:context=".funcionalidades.vendas.ResumoVendasActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="70dp">

        <!-- ══════════════════════════════
             HEADER TEAL
             ══════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/colorPrimary">

            <!-- Linha 1: Avatar | OrgaFácil + nome | Settings -->
            <LinearLayout
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <!-- Círculo avatar -->
                <LinearLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_avatar_vendas"
                    android:gravity="center"
                    android:layout_marginEnd="10dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="O"
                        android:textColor="@color/colorPrimary"
                        android:textStyle="bold"
                        android:textSize="16sp"/>
                </LinearLayout>

                <!-- Título + sub -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OrgaFácil"
                        android:textColor="@android:color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/textNomeVendedor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bem-vindo"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12sp"/>
                </LinearLayout>

                <!-- Settings -->
                <ImageButton
                    android:id="@+id/btnConfiguracoesVendas"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_manage_accounts_96"
                    android:scaleType="fitCenter"
                    android:padding="8dp"
                    android:contentDescription="Configurações"
                    app:tint="@android:color/white"/>

            </LinearLayout>

            <!-- Linha 2: Stats card (branco, flutuante) -->
            <LinearLayout
                android:id="@+id/headerResumoVendas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_stats_card"
                android:elevation="3dp"
                android:paddingVertical="14dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- VENDAS -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VENDAS"
                        android:textColor="@color/cor_stats_label"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"/>
                    <TextView
                        android:id="@+id/textQtdVendas"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/cor_stats_valor"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:layout_marginTop="2dp"
                        tools:text="8"/>
                </LinearLayout>

                <!-- Divisor -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E0E0E0"/>

                <!-- HOJE -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOJE"
                        android:textColor="@color/cor_stats_label"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"/>
                    <TextView
                        android:id="@+id/textVendasHoje"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="R$ 0,00"
                        android:textColor="@color/cor_stats_valor_hoje"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"
                        tools:text="R$ 157"/>
                </LinearLayout>

                <!-- Divisor -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="#E0E0E0"/>

                <!-- CAIXA -->
                <LinearLayout
                    android:id="@+id/layoutStatusCaixa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CAIXA"
                        android:textColor="@color/cor_stats_label"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textAllCaps="true"/>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:id="@+id/textStatusCaixa"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fechado"
                            android:textColor="@color/cor_stats_caixa_fechado"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            tools:text="Aberto"/>
                        <ImageView
                            android:id="@+id/imgStatusCaixa"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="3dp"
                            android:src="@drawable/ic_lock_24"
                            app:tint="@color/cor_stats_caixa_fechado"/>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="toque p/ gerir"
                        android:textColor="@color/cor_stats_label"
                        android:textSize="9sp"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════
             CORPO BRANCO + ABAS
             ══════════════════════════════ -->
        <LinearLayout
            android:id="@+id/scrollMeio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/header_background"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingHorizontal="8dp">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabLayoutDashboard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:tabIndicatorColor="?attr/colorPrimary"
                app:tabSelectedTextColor="?attr/colorPrimary"
                app:tabTextColor="?attr/colorOnSurface"
                app:tabTextAppearance="@android:style/TextAppearance.Medium"
                app:tabMode="fixed"
                app:tabGravity="fill"/>

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerDashboard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════════════════════
         BOTTOM APP BAR
         ══════════════════════════════ -->
    <com.google.android.material.bottomappbar.BottomAppBar
        android:id="@+id/bottomAppBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        app:fabAlignmentMode="center"
        app:fabCradleMargin="10dp"
        app:fabCradleRoundedCornerRadius="15dp"
        app:fabCradleVerticalOffset="10dp"
        app:backgroundTint="@color/colorPrimary"
        app:contentInsetStart="0dp"
        app:contentInsetEnd="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:id="@+id/btn_footer_vendas"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingEnd="40dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_shopping_cart_96"
                    app:tint="#FFFFFF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vendas"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_footer_financeiro"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_paid_28"
                    app:tint="#80FFFFFF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Financeiro"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.bottomappbar.BottomAppBar>

    <!-- Overlay e speed-dial FABs (sem alteração de lógica) -->
    <View
        android:id="@+id/overlay_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone"
        android:alpha="0"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"/>

    <View
        android:id="@+id/radial_spotlight"
        android:layout_width="350dp"
        android:layout_height="350dp"
        android:background="@drawable/bg_radial_spotlight"
        android:visibility="invisible"
        android:alpha="0"
        android:scaleX="0"
        android:scaleY="0"
        app:layout_anchor="@id/fab_main"
        app:layout_anchorGravity="center"
        app:elevation="11dp"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_novo_cliente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        android:alpha="0"
        app:backgroundTint="#4CAF50"
        app:fabSize="mini"
        app:layout_anchor="@id/bottomAppBar"
        app:layout_anchorGravity="center"
        app:srcCompat="@drawable/ic_person_24"
        app:tint="@color/white"
        app:elevation="12dp"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_novo_orcamento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        android:alpha="0"
        app:backgroundTint="#2196F3"
        app:fabSize="mini"
        app:layout_anchor="@id/bottomAppBar"
        app:layout_anchorGravity="center"
        app:srcCompat="@drawable/ic_lapis_editar_24"
        app:tint="@color/white"
        app:elevation="12dp"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_nova_venda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="invisible"
        android:alpha="0"
        app:backgroundTint="#FF9800"
        app:fabSize="mini"
        app:layout_anchor="@id/bottomAppBar"
        app:layout_anchorGravity="center"
        app:srcCompat="@drawable/ic_shopping_cart_96"
        app:tint="@color/white"
        app:elevation="12dp"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#FF4081"
        android:translationY="-40dp"
        app:layout_anchor="@id/bottomAppBar"
        app:layout_anchorGravity="center"
        app:srcCompat="@drawable/ic_shopping_cart_checkout_24"
        app:tint="@color/white"
        app:elevation="12dp"
        app:pressedTranslationZ="12dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
